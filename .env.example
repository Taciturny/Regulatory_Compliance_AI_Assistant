# Server-side secrets only. Never commit .env or expose these values in browser code.
LLM_API_KEY=your_google_ai_studio_api_key
LLM_MODEL=gemini-flash-latest
COHERE_API_KEY=your_cohere_api_key
COHERE_MODEL=command-a-plus-05-2026
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=regulatoryai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Conservative shared-instance controls for an invite-only beta; tune to provider quotas.
CHAT_REQUESTS_PER_MINUTE=10
MAX_CONCURRENT_CHAT_REQUESTS=3
LOG_LEVEL=INFO
